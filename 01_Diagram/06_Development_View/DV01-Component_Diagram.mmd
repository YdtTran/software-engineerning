flowchart LR
    subgraph presentation["Presentation — existing mockup only"]
        student["Student mobile experience"]
        opmobile["Operator field mobile experience"]
        opweb["Operator web dashboard experience"]
        preview["Shared preview shell<br/>index.html + app.js"]
    end
    student -. "planned HTTP" .-> http
    opmobile -. "planned HTTP" .-> http
    opweb -. "planned HTTP" .-> http

    subgraph api["API / Interface — MVP target"]
        http["Express HTTP API"]
    end

    subgraph application["Application — modules in one backend"]
        accounts["Accounts & Resources<br/>VehicleService<br/>UC01–02, UC08–09"]
        reservations["Reservations & Trips<br/>ReservationHub; trip coordination<br/>UC03–06; FR-NI01"]
        charging["Charging<br/>ChargingScheduler<br/>UC07, UC12"]
        operations["Operations<br/>RedistributionService; IncidentService;<br/>TelemetryService<br/>UC08–11; FR-NI02–04"]
        simulation["Simulation<br/>SimulationEngine<br/>UC13–14"]
        useCaseModules[["Use-case Modules"]]
        telemetryIn["&lt;&lt;interface&gt;&gt;<br/>Telemetry Input Contract<br/>application use-case contract"]
        repoPort["&lt;&lt;interface&gt;&gt;<br/>RepositoryPort<br/>resource / reservation / charging /<br/>operations / simulation"]
        notificationPort["&lt;&lt;interface&gt;&gt;<br/>NotificationPort"]
    end

    subgraph domain["Domain — business rules"]
        domainModel["Domain model & invariants<br/>accounts, hubs, vehicles, slots,<br/>reservations, trips, charging,<br/>transfers, incidents, simulations"]
    end

    subgraph infrastructure["Infrastructure — MVP adapters"]
        sqliteAdapter["SQLite repository adapter"]
        sqlite["SQLite persistence<br/>(target technology)"]
        simulatedTelemetry["Simulated telemetry adapter<br/>real protocol TBD"]
        mockNotification["Mock notification adapter<br/>provider TBD"]
    end

    http -. "uses" .-> useCaseModules

    useCaseModules -. "uses" .-> domainModel
    useCaseModules -. "uses" .-> repoPort
    useCaseModules -. "uses" .-> notificationPort
    operations -. "realizes" .-> telemetryIn
    http -. "submits telemetry" .-> telemetryIn

    sqliteAdapter -. "realizes" .-> repoPort
    sqliteAdapter -. "persists state" .-> sqlite
    simulatedTelemetry -. "submits telemetry" .-> telemetryIn
    mockNotification -. "realizes" .-> notificationPort

    classDef target fill:#eff6ff,stroke:#0284c7,color:#0f172a;
    classDef port fill:#e0f2fe,stroke:#0284c7,color:#0c4a6e;
    classDef mock fill:#fffbeb,stroke:#d97706,color:#78350f;
    class http,sqlite,sqliteAdapter target;
    class telemetryIn,repoPort,notificationPort port;
    class simulatedTelemetry,mockNotification,preview mock;

    %% Mermaid approximates UML interface/realization glyphs; see PlantUML for exact notation.
    %% Dashed arrows point from a client component to its supplier interface.
    %% The diagram does not represent deployment nodes.
