# Copy to .env (ignored by Git) before running `docker compose up -d --build`

# For local HTTP testing only (non-TLS), set NODE_ENV=development and DEMO_INSECURE_HTTP=1.
# Behind an HTTPS reverse proxy (Render, Railway, Caddy, Nginx), keep NODE_ENV=production and DEMO_INSECURE_HTTP=0.
NODE_ENV=production
DEMO_PORT=3000
DEMO_INSECURE_HTTP=0
TRUST_PROXY=1

# Seed mode on first boot when the SQLite file does not exist yet:
# - dashboard: pre-populates green/yellow/red hubs, an open fault incident, and queued charging requests
# - clean: neutral seed where all resources start Available
DEMO_SEED_MODE=dashboard

# Set to 1 for interactive demo without physical IoT hardware; set to 0 in production with real hardware adapters
DEMO_SIMULATED_DEVICES=1

# Credentials hashed into /data/accounts.json (salted scrypt) at startup — never commit real passwords
DEMO_OPERATOR_USERNAME=operator
DEMO_OPERATOR_PASSWORD=change-me-operator-password
DEMO_USER_USERNAME=user
DEMO_USER_PASSWORD=change-me-user-password
